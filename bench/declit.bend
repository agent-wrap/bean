    IO.print(sh(I.dec_mul([49, 48], [51])) ++ " " ++ sh(I.dec_div([49, 48], [51])) ++ " " ++ sh(I.dec_mod([49, 48], [51])) ++ " " ++ bs(I.dec_eq([49, 48], [51])) ++ " " ++ bs(I.lit_ok(4, [49, 48], [51])) ++ " " ++ sh(I.dec_pow([49, 48], [51])))
    IO.print(sh(I.dec_mul([52, 50, 57, 52, 57, 54, 55, 50, 57, 54], [50])) ++ " " ++ sh(I.dec_div([52, 50, 57, 52, 57, 54, 55, 50, 57, 54], [50])) ++ " " ++ sh(I.dec_mod([52, 50, 57, 52, 57, 54, 55, 50, 57, 54], [50])) ++ " " ++ bs(I.dec_eq([52, 50, 57, 52, 57, 54, 55, 50, 57, 54], [50])) ++ " " ++ bs(I.lit_ok(4, [52, 50, 57, 52, 57, 54, 55, 50, 57, 54], [50])) ++ " " ++ sh(I.dec_pow([52, 50, 57, 52, 57, 54, 55, 50, 57, 54], [50])))
    IO.print(sh(I.dec_mul([50], [51, 50])) ++ " " ++ sh(I.dec_div([50], [51, 50])) ++ " " ++ sh(I.dec_mod([50], [51, 50])) ++ " " ++ bs(I.dec_eq([50], [51, 50])) ++ " " ++ bs(I.lit_ok(4, [50], [51, 50])) ++ " " ++ sh(I.dec_pow([50], [51, 50])))
