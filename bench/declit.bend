# Probe: decimal literal arithmetic (infer.bend dec_*) vs Python big ints.
import Base
import ../src/infer.bend as I

def sh(xs: List<&2, U32>) -> String:
  match xs:
    case Nil{}:
      ""
    case Con{head, tail}:
      U32.show((head - 48 : U32)) ++ sh(tail)

def bs(+b: Bool) -> String:
  match b:
    case True{}:
      "T"
    case False{}:
      "F"

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(sh(I.dec_mul([48], [48])) ++ " " ++ sh(I.dec_div([48], [48])) ++ " " ++ sh(I.dec_mod([48], [48])) ++ " " ++ bs(I.dec_eq([48], [48])) ++ " " ++ bs(I.lit_ok(4, [48], [48])) ++ " " ++ sh(I.dec_pow([48], [48])))
    IO.print(sh(I.dec_mul([48], [53])) ++ " " ++ sh(I.dec_div([48], [53])) ++ " " ++ sh(I.dec_mod([48], [53])) ++ " " ++ bs(I.dec_eq([48], [53])) ++ " " ++ bs(I.lit_ok(4, [48], [53])) ++ " " ++ sh(I.dec_pow([48], [53])))
    IO.print(sh(I.dec_mul([53], [48])) ++ " " ++ sh(I.dec_div([53], [48])) ++ " " ++ sh(I.dec_mod([53], [48])) ++ " " ++ bs(I.dec_eq([53], [48])) ++ " " ++ bs(I.lit_ok(4, [53], [48])) ++ " " ++ sh(I.dec_pow([53], [48])))
    IO.print(sh(I.dec_mul([49], [49])) ++ " " ++ sh(I.dec_div([49], [49])) ++ " " ++ sh(I.dec_mod([49], [49])) ++ " " ++ bs(I.dec_eq([49], [49])) ++ " " ++ bs(I.lit_ok(4, [49], [49])) ++ " " ++ sh(I.dec_pow([49], [49])))
